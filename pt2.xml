<project>


  <path id="project.class.path">
    <pathelement location="build/src"/>
    <pathelement location="lib/junit-4.8.2.jar"/>
  </path>

  <target name="compile" description="compile the code">
    <mkdir dir="build" />
    <javac srcdir="src"
	         destdir="build"
	         includeantruntime="false"
	         debug="true" >
      <classpath refid="project.class.path" />
    </javac>
  </target>

  <target name="test-compile" depends="compile" description="compile the test code">
    <mkdir dir="build/tests" />
    <javac srcdir="tests"
           destdir="build/tests"
           includeantruntime="false"
           debug="true" >
      <classpath refid="project.class.path" />
    </javac>
  </target>

  <target name="clean" description="clean up the project">
    <delete>
      <fileset dir="build/src" includes="*.class"/>
      <fileset dir="build/src" includes="*.jar"/>
      <fileset dir="build/tests" includes="*.class"/>
    </delete>
  </target>


  <target name="run" depends="compile" description="run the main">
    <java classname="UseTest">
      <classpath>
        <pathelement path="project.class.path/src"/>
      </classpath>
    </java>
  </target>

  <target name="jar" depends="compile" description="create a jar file">
    <jar destfile="lib/NSetCache.jar">
      <fileset dir="build"
               includes="*.class"/>
      <manifest>
	<attribute name="Main-Class" value="NSetCache"/>
      </manifest>
    </jar>
  </target>

  <target name="test" depends="test-compile" description="run JUnit tests">
    <junit haltonerror="no" haltonfailure="no">
      <classpath refid="project.class.path" />
      <batchtest fork="yes">
      	<fileset dir="tests" includes="*Test.java"/>
      </batchtest>
      <formatter type="brief" usefile="false" />
    </junit>
  </target>
</project>
